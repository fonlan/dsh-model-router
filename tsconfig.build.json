{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
