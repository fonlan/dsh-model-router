{
  "name": "@fonlan/dsh-model-router",
  "version": "0.3.5",
  "description": "DSH plugin: a virtual model-router provider that aggregates every configured provider and model, routes each request to the model's currently active provider, and ships a settings page for per-model provider ordering and switching.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonlan/dsh-model-router.git"
  },
  "bugs": {
    "url": "https://github.com/fonlan/dsh-model-router/issues"
  },
  "homepage": "https://github.com/fonlan/dsh-model-router",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "model-router",
    "provider",
    "routing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.2-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.21.0"
}
